# --- Required for the "ask it in plain English" feature ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Your anchor point for the 20-minute radius ---
# A ZIP, cross-streets, or full address. Never commit your real one.
VD_ANCHOR=89148
VD_DRIVE_MINUTES=20   # exact. not 21.

# --- Optional but recommended: real road-network drive times ---
# Free key (2000 req/day): https://openrouteservice.org/dev/#/signup
# Matters most from a valley-edge anchor like 89148, where the 215 makes real
# drive times much better than straight-line distance suggests. Without a key,
# the Strip cluster (89109/89102/89169) lands just outside a 20-minute budget.
# Run `python -m vegasdeals radius` to see exactly where your line falls.
ORS_API_KEY=

# No ORS key? Raise this instead. 26 is a conservative surface-street average;
# a beltway-adjacent anchor realistically averages 30-34.
VD_FALLBACK_MPH=26

# --- Clark County tax model (see README: Out-the-door pricing) ---
VD_TAX_MODE=additive          # additive | compound
VD_EXCISE_RATE=0.10           # NV adult-use retail excise
VD_LOCAL_CANNABIS_RATE=0.03   # Clark County cannabis tax
VD_SALES_TAX_RATE=0.08375     # Clark County sales tax
VD_MEDICAL_CARD=false         # true exempts the 10% excise

# --- Crawler politeness ---
VD_CONCURRENCY=3
VD_DELAY_SECONDS=2.0
VD_HEADLESS=true
